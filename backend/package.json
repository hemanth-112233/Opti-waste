{
    "name": "optiwaste-backend-node",
    "version": "1.0.0",
    "description": "Express Mongoose OptiWaste API",
    "main": "src/server.ts",
    "scripts": {
        "start": "node dist/server.js",
        "dev": "nodemon",
        "build": "tsc -p tsconfig.json",
        "seed:waste-demo": "npx ts-node -r dotenv/config src/scripts/seedWasteDemoData.ts",
        "seed:verification-demo": "npx ts-node -r dotenv/config src/scripts/seedVerificationDemoData.ts"
    },
    "dependencies": {
        "bcrypt": "^5.1.1",
        "compression": "^1.7.4",
        "cors": "^2.8.6",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.3.4",
        "morgan": "^1.10.0",
        "swagger-ui-express": "^5.0.0",
        "uuid": "^9.0.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.12.11",
        "@types/swagger-ui-express": "^4.1.6",
        "@types/uuid": "^9.0.8",
        "nodemon": "^3.1.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.4.5"
    }
}